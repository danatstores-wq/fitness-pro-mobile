{
  "expo": {
    "name": "Fitness Pro by Danat",
    "slug": "fitness-pro-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/images/Luxury Fitness Pro Emblem.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.danat.fitnesspro",
      "infoPlist": {
        "NSCameraUsageDescription": "Fitness Pro uses the camera to scan packaged food barcodes and retrieve nutrition information."
      }
    },
    "android": {
      "package": "com.danat.fitnesspro",
      "icon": "./assets/images/Luxury Fitness Pro Emblem.png"
    },
    "web": {
      "output": "single"
    },
    "experiments": {
      "baseUrl": "/fitness-pro-mobile"
    },
    "plugins": [
      [
        "@appeeky/expo-healthkit",
        {
          "healthSharePermission": "Fitness Pro reads your daily step count to display your activity progress.",
          "healthUpdatePermission": false,
          "healthConnectPermissions": [
            "READ_STEPS"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Fitness Pro to scan packaged food barcodes.",
          "microphonePermission": "Allow Fitness Pro to use the microphone only when recording video.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "reminders",
          "color": "#EFFF00",
          "enableRemoteNotifications": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1622329571366129~2966325014",
          "iosAppId": "ca-app-pub-1622329571366129~8528682424",
          "userTrackingUsageDescription": "Fitness Pro uses device identifiers to measure advertising performance and support ad delivery."
        }
      ]
    ]
  }
}
